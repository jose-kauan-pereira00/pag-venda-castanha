---
import { site, nav } from "../data/site";

const ano = new Date().getFullYear();
---

<footer class="bg-azul-950 text-azul-200">
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-5 py-12 md:flex-row md:items-start md:justify-between">
    <div class="flex items-center gap-3">
      <img src="/logo.svg" alt="" width="36" height="36" />
      <div>
        <p class="font-display text-lg text-white">{site.nome}</p>
        <p class="text-sm">{site.descricao}</p>
      </div>
    </div>
    <nav aria-label="Rodapé">
      <ul class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        {nav.map((item) => <li><a href={item.href} class="hover:text-white">{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-white/10 py-5 text-center text-xs">
    © {ano} {site.nome}. Todos os direitos reservados.
  </div>
</footer>
