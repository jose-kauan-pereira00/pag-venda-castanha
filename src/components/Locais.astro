---
import { locais } from "../data/locais";
import LocalItem from "./LocalItem.astro";
---

<section id="localidades" class="bg-white py-24">
  <div class="mx-auto max-w-6xl px-5">
    <h2 class="font-display text-4xl md:text-5xl text-amber-800">Onde Encontrar</h2>
    <p class="mt-4 max-w-xl text-azul-800">
      Venha buscar sua <b class="text-amber-700">castanha</b> ainda quentinha. Veja os pontos de venda e os horários.
    </p>
    <div class="mt-14 border-t border-azul-100">
      {locais.map((local) => <LocalItem {...local} />)}
    </div>
  </div>
</section>
