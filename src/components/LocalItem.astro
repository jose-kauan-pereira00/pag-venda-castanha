---
import type { Local } from "../data/locais";

type Props = Local;
const { nome, endereco, horarios, foto } = Astro.props;
---

<article class="grid gap-6 border-b border-azul-100 py-10 md:grid-cols-[2fr_3fr] md:gap-12">
  <img src={foto} alt={`Ponto de venda: ${nome}`} class="aspect-[4/3] w-full rounded-sm object-cover" loading="lazy" />
  <div class="flex flex-col justify-center">
    <h3 class="font-display text-2xl md:text-3xl">{nome}</h3>
    <p class="mt-2 text-azul-800">{endereco}</p>
    <dl class="mt-6 max-w-sm divide-y divide-azul-100 border-y border-azul-100 text-sm">
      {
        horarios.map((h) => (
          <div class="flex justify-between gap-4 py-2">
            <dt class="font-medium">{h.dias}</dt>
            <dd>{h.horas}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</article>
