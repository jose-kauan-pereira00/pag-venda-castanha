---
import { site, linkWhatsapp, linkInstagram } from "../data/site";

const contatos = [
  {
    rotulo: "WhatsApp",
    valor: site.whatsappExibicao,
    href: linkWhatsapp("Olá! Vim pelo site e gostaria de fazer um pedido."),
  },
  { rotulo: "Instagram", valor: `@${site.instagram}`, href: linkInstagram },
];
---

<section id="contato" class="bg-azul-900 py-24 text-white">
  <div class="mx-auto grid max-w-6xl gap-12 px-5 md:grid-cols-2 md:items-end">
    <div>
      <h2 class="font-display text-4xl md:text-5xl">Fale com a gente</h2>
      <p class="mt-4 max-w-md text-azul-100">
        Encomendas, dúvidas ou pedidos para eventos: é só chamar.
      </p>
    </div>
    <ul class="space-y-6">
      {
        contatos.map((c) => (
          <li>
            <a
              href={c.href}
              target="_blank"
              rel="noopener"
              class="block border-b border-azul-200/40 pb-4 hover:border-torra"
            >
              <span class="block text-sm text-azul-200">{c.rotulo}</span>
              <span class="font-display text-2xl md:text-3xl">{c.valor}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
